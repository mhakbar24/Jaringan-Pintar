<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_main"
    tools:context=".MateriActivity">

    <ImageView
        android:id="@+id/btn_back_materi"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/tv_page_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Materi TJKT"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:shadowColor="#40000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:layout_constraintBottom_toBottomOf="@+id/btn_back_materi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_back_materi" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_page_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Modul 1 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_materi_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_modern"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/icon_m1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="7dp"
                    android:src="@drawable/terkini"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/title_m1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Teknologi Serat Optik Terkini"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/icon_m1"
                    app:layout_constraintTop_toTopOf="@+id/icon_m1" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Perkembangan &amp; sejarah fiber optik"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@+id/icon_m1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/title_m1"
                    app:layout_constraintTop_toBottomOf="@+id/title_m1" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Modul 2 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_materi_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_modern"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/icon_m2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="6dp"
                    android:src="@drawable/kar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/title_m2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Karakteristik Kabel Fiber Optik"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/icon_m2"
                    app:layout_constraintTop_toTopOf="@+id/icon_m2" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Karakteristik &amp; Fungsi Fiber Optik"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@+id/icon_m2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/title_m2"
                    app:layout_constraintTop_toBottomOf="@+id/title_m2" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Modul 3 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_materi_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_modern"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/icon_m3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="6dp"
                    android:src="@drawable/facef"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/title_m3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Struktur Kabel Fiber Optik"
                    android:textColor="#212121"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/icon_m3"
                    app:layout_constraintTop_toTopOf="@+id/icon_m3" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Struktur Fiber Optik dan Penggunaannya"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@+id/icon_m3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/title_m3"
                    app:layout_constraintTop_toBottomOf="@+id/title_m3" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Modul 4 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_materi_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_modern"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/icon_m4"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="8dp"
                    android:src="@drawable/ic_fo"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/title_m4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Jenis &amp; Prinsip Kerja Fiber Optik"
                    android:textColor="#212121"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/icon_m4"
                    app:layout_constraintTop_toTopOf="@+id/icon_m4" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Single mode, multi mode &amp; cara kerja"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@+id/icon_m4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/title_m4"
                    app:layout_constraintTop_toBottomOf="@+id/title_m4" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Modul 5 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_materi_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_modern"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/icon_m5"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle"
                    android:src="@drawable/ic_iot"
                    android:padding="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/title_m5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Internet of Things (IoT)"
                    android:textColor="#212121"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/icon_m5"
                    app:layout_constraintTop_toTopOf="@+id/icon_m5" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Konsep benda yang terhubung internet"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@+id/icon_m5"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/title_m5"
                    app:layout_constraintTop_toBottomOf="@+id/title_m5" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Modul 6 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_materi_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_modern"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/icon_m6"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="8dp"
                    android:src="@drawable/ic_dc"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/title_m6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Data Center"
                    android:textColor="#212121"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/icon_m6"
                    app:layout_constraintTop_toTopOf="@+id/icon_m6" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Pusat penyimpanan &amp; pengolahan data"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@+id/icon_m6"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/title_m6"
                    app:layout_constraintTop_toBottomOf="@+id/title_m6" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Modul 7 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_materi_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_modern"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/icon_m7"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="8dp"
                    android:src="@drawable/ic_cc"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/title_m7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Cloud Computing"
                    android:textColor="#212121"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/icon_m7"
                    app:layout_constraintTop_toTopOf="@+id/icon_m7" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Teknologi komputasi awan"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@+id/icon_m7"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/title_m7"
                    app:layout_constraintTop_toBottomOf="@+id/title_m7" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Modul 8 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_materi_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:background="@drawable/bg_card_modern"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/icon_m8"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="8dp"
                    android:src="@drawable/ic_cs"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/title_m8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Keamanan &amp; Penetrasi"
                    android:textColor="#212121"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/icon_m8"
                    app:layout_constraintTop_toTopOf="@+id/icon_m8" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Kerahasiaan &amp; penetrasi internet"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@+id/icon_m8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/title_m8"
                    app:layout_constraintTop_toBottomOf="@+id/title_m8" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>